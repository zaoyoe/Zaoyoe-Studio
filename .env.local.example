# Local-only storage / R2 settings
# Copy to .env.local and fill with real values for your machine only.

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_ANON_KEY=

CLOUDFLARE_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=
R2_PUBLIC_URL=
R2_SECRET_ACCESS_KEY=
R2_SECRET_KEY=

# Optional request-security tuning
TRUST_ALL_PROXIES=false
TRUSTED_PROXY_IPS=
AFDIAN_WEBHOOK_TRUSTED_PROXIES=
AFDIAN_WEBHOOK_ALLOWED_IPS=
AUTH_LOGIN_SECURITY_RATE_LIMIT_MAX=20
PAYMENTS_CREATE_RATE_LIMIT_MAX=12
AFDIAN_QUERY_RATE_LIMIT_MAX=25

# Guest shop cash channel (leave secrets empty locally unless running a fixture)
GUEST_SHOP_CLAIM_PEPPER=
GUEST_SHOP_CLAIM_DERIVATION_PEPPER=
GUEST_SHOP_CONTACT_HASH_PEPPER=
GUEST_SHOP_REQUEST_HASH_PEPPER=
GUEST_SHOP_WORKER_SECRET=
GUEST_SHOP_ORDER_TTL_SECONDS=1800
GUEST_SHOP_PAYMENT_CREATE_LEASE_MS=120000
GUEST_SHOP_WEBHOOK_GLOBAL_LIMIT=1200
GUEST_SHOP_WEBHOOK_IP_LIMIT=120
GUEST_SHOP_ZPAY_WEBHOOK_URL=
GUEST_SHOP_NOWPAYMENTS_WEBHOOK_URL=
ZPAY_PKEY=
ZPAY_KEY=
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
RATE_LIMIT_BACKEND=
RATE_LIMIT_STORE=
DISABLE_PERSISTENT_RATE_LIMITS=false
GUEST_SHOP_ENABLED_PROVIDERS=
