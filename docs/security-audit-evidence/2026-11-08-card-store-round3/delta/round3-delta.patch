+            return { released: false, reason: 'TASK_REQUIRES_REVIEW' };
+        }
+        const cdks = await runQuery('SELECT * FROM cdk_codes WHERE cdk_code = ? LIMIT 1 FOR UPDATE', [task.cdk_code], { connection });
