+        const outerWhere = wholeWhere.split(/ AND \(LEFT\(| AND NOT EXISTS/)[0];
+        const offset = (sql.slice(0, whereIndex).match(/\?/g) || []).length;
+        let parameter = offset;
+        if (/\bid = \?/.test(outerWhere) && row.id !== Number(params[parameter++])) return false;
