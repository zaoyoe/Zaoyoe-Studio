# Environment Configuration for Verify Server

# Supabase
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Shared USDT/CNY snapshots for TG, guest purchases and logged-in wallet recharge.
# Apply supabase/migrations/20261016_payment_usdt_market_fx.sql manually first.
# market refreshes on demand every 5 min; unavailable/stale FX blocks new USDT orders.
# Existing payment verification always uses the saved order amounts.
PAYMENT_USDT_FX_MODE=fixed

# Server
PORT=3001
VERIFY_API_BASE_URL=https://a8yx0rez5w.localto.net
VERIFY_API_KEY=ak_your_verify_api_key_here

# CORS - comma separated origins
ALLOWED_ORIGINS=http://localhost:8000,https://fatherkey.com,https://www.fatherkey.com,https://zaoyoe.xyz,https://www.zaoyoe.xyz
MOCK_VERIFY=false
VERIFY_SERVER_WORKERS_ENABLED=true
TRUSTED_PROXY_IPS=
TRUST_ALL_PROXIES=false
AFDIAN_WEBHOOK_TRUSTED_PROXIES=
AFDIAN_WEBHOOK_ALLOWED_IPS=

# Afdian (爱发电) - Get from https://afdian.net/dashboard/dev
AFDIAN_USER_ID=your_afdian_user_id
AFDIAN_TOKEN=your_afdian_token

# Supplier platform 2.0 — server-only credentials. Never put these in public JS.
# The account must also exist in shop_supplier_accounts and be explicitly enabled
# for read-only catalog access. This does not enable products or procurement.
# Keep CURRENCY empty until the merchant confirms API amount units and currency.
SUPPLIER_XIARENG_APP_ID=
SUPPLIER_XIARENG_APP_KEY=
SUPPLIER_XIARENG_CURRENCY=
SUPPLIER_XIARENG_TIMEOUT_MS=10000
# A second account uses credential_ref env:SUPPLIER_XIARENG_SECOND and separate:
# SUPPLIER_XIARENG_SECOND_APP_ID, _APP_KEY, _CURRENCY, _TIMEOUT_MS.
# Existing 16688 default remains env:SUPPLIER_16688 (_APP_ID, _SECRET).

# Supplier 2.0 native checkout remains off until procurement/delivery acceptance.
SHOP_SUPPLIER_CHECKOUT_V2_ENABLED=false

# P2C private procurement protocol: no automatic worker/route is installed.
# Independent per-account verified contract + DB dispatch policy are also required.
SHOP_SUPPLIER_DISPATCH_V2_ENABLED=false
# May stay enabled during a dispatch pause; query-only, never resubmits.
SHOP_SUPPLIER_RECONCILE_V2_ENABLED=false

# P2D-1 complete, original-order delivery query. No worker is installed or enabled.
SHOP_SUPPLIER_DELIVERY_V2_ENABLED=false

# P2E operator-controlled manual purchase (plan B). There is NO automatic worker:
# an administrator opens the drawer, sees the live quote, then explicitly confirms
# one purchase. Keep false in production until the operator runbook is accepted.
SHOP_SUPPLIER_MANUAL_PURCHASE_ENABLED=false
# Independent secret seeds (>=32 chars), JSON object keyed by key ID. Keep old
# entries for historical decryption; rotate only ACTIVE_KEY for new receipts.
SHOP_SUPPLIER_DELIVERY_KEYS={}
SHOP_SUPPLIER_DELIVERY_ACTIVE_KEY=
# Independent stable HMAC seed. Do not rotate without a separate migration:
# duplicate-content protection depends on fingerprints remaining stable.
# Never reuse a delivery key, CRON_SECRET or SUPABASE_SERVICE_ROLE_KEY.
SHOP_SUPPLIER_DELIVERY_FINGERPRINT_KEY=

# P2E: explicitly invoked single-batch coordinator; no timer installed.
# Each phase still requires its own flag and account/SKU/merchant admission.
# Current Xiareng/16688 adapters do not have the runtime/transaction contracts.
SHOP_SUPPLIER_RUNTIME_V2_ENABLED=false
