# Environment Configuration for Verify Server

# Supabase
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Shared USDT/CNY snapshots for TG, guest purchases and logged-in wallet recharge.
# Apply supabase/migrations/20261016_payment_usdt_market_fx.sql manually first.
# market refreshes on demand every 5 min; unavailable/stale FX blocks new USDT orders.
# Existing payment verification always uses the saved order amounts.
PAYMENT_USDT_FX_MODE=fixed

# Server
PORT=3001
VERIFY_API_BASE_URL=https://a8yx0rez5w.localto.net
VERIFY_API_KEY=ak_your_verify_api_key_here

# CORS - comma separated origins
ALLOWED_ORIGINS=http://localhost:8000,https://fatherkey.com,https://www.fatherkey.com,https://zaoyoe.xyz,https://www.zaoyoe.xyz
MOCK_VERIFY=false
VERIFY_SERVER_WORKERS_ENABLED=true
TRUSTED_PROXY_IPS=
TRUST_ALL_PROXIES=false
AFDIAN_WEBHOOK_TRUSTED_PROXIES=
AFDIAN_WEBHOOK_ALLOWED_IPS=

# Afdian (爱发电) - Get from https://afdian.net/dashboard/dev
AFDIAN_USER_ID=your_afdian_user_id
AFDIAN_TOKEN=your_afdian_token
