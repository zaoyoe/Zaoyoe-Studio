# Production / staging server settings
# Copy to server/.env.production in the deployment environment only.

PORT=3001
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
VERIFY_API_BASE_URL=https://a8yx0rez5w.localto.net
VERIFY_API_KEY=
ALLOWED_ORIGINS=
MOCK_VERIFY=false
VERIFY_SERVER_WORKERS_ENABLED=true
# Optional low-latency guest fulfillment kick. Keep false/unset unless the
# long-running KVM4 verify-server process is ready; the systemd timer remains
# the durable fallback.
GUEST_SHOP_IMMEDIATE_FULFILLMENT_ENABLED=false
TRUSTED_PROXY_IPS=
TRUST_ALL_PROXIES=false
AFDIAN_WEBHOOK_TRUSTED_PROXIES=
AFDIAN_WEBHOOK_ALLOWED_IPS=

# Guest shop cash channel. Populate secrets only in the deployment secret store.
APP_ENV=production
GUEST_SHOP_CLAIM_PEPPER=
GUEST_SHOP_CLAIM_DERIVATION_PEPPER=
GUEST_SHOP_CONTACT_HASH_PEPPER=
GUEST_SHOP_REQUEST_HASH_PEPPER=
GUEST_SHOP_WORKER_SECRET=
GUEST_SHOP_ORDER_TTL_SECONDS=1800
GUEST_SHOP_PAYMENT_CREATE_LEASE_MS=120000
GUEST_SHOP_WEBHOOK_GLOBAL_LIMIT=1200
GUEST_SHOP_WEBHOOK_IP_LIMIT=120
GUEST_SHOP_ZPAY_WEBHOOK_URL=
GUEST_SHOP_NOWPAYMENTS_WEBHOOK_URL=
ZPAY_PKEY=
ZPAY_KEY=
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
GUEST_SHOP_ENABLED_PROVIDERS=
RATE_LIMIT_BACKEND=
RATE_LIMIT_STORE=
DISABLE_PERSISTENT_RATE_LIMITS=false

# Optional staging payment smoke test inputs
APP_BASE_URL=
PAYMENT_SMOKE_BASE_URL=
PAYMENT_SMOKE_EMAIL=
PAYMENT_SMOKE_PASSWORD=

# Optional guarded rollout inputs
PAYMENT_ROLLOUT_TARGET_REF=
PAYMENT_ROLLOUT_DB_URL=

# Optional AI image workbench model runtime.
# Prefer a dedicated key for commercial image generation.
AI_WORKBENCH_BILLING_V2_ENABLED=false
AI_WORKBENCH_DYNAMIC_AUTHORIZATION_POINTS=1
AI_IMAGE_API_KEY=
AI_IMAGE_API_BASE_URL=https://api.openai.com/v1
AI_IMAGE_MODEL=gpt-image-2
AI_IMAGE_CHAT_MODEL=gpt-4o-mini
AI_IMAGE_CHAT_MAX_TOKENS=
AI_IMAGE_RESPONSE_FORMAT=
AI_IMAGE_QUALITY=
AI_IMAGE_PROVIDER_TIMEOUT_MS=120000
AI_IMAGE_RESPONSE_BODY_TIMEOUT_MS=120000
AI_IMAGE_TASK_TIMEOUT_MS=150000
AI_IMAGE_VIDEO_TASK_TIMEOUT_MS=720000
AI_IMAGE_STALE_RUNNING_TIMEOUT_MS=180000
AI_IMAGE_VIDEO_STALE_RUNNING_TIMEOUT_MS=840000

# AI image cost firewall. These limits are layered by global, IP, user, model,
# and task state so one abusive account cannot exhaust the whole service.
AI_IMAGE_RATE_LIMIT_SUBMIT_GLOBAL_MAX=180
AI_IMAGE_RATE_LIMIT_SUBMIT_IP_MAX=30
AI_IMAGE_RATE_LIMIT_SUBMIT_USER_MAX=12
AI_IMAGE_RATE_LIMIT_SUBMIT_HEAVY_USER_MAX=4
AI_IMAGE_RATE_LIMIT_SUBMIT_MODEL_MAX=6
AI_IMAGE_RATE_LIMIT_UPLOAD_GLOBAL_MAX=420
AI_IMAGE_RATE_LIMIT_UPLOAD_IP_MAX=36
AI_IMAGE_RATE_LIMIT_UPLOAD_USER_MAX=18
AI_IMAGE_RATE_LIMIT_DOWNLOAD_GLOBAL_MAX=1200
AI_IMAGE_RATE_LIMIT_DOWNLOAD_IP_MAX=180
AI_IMAGE_RATE_LIMIT_DOWNLOAD_USER_MAX=120
AI_IMAGE_RATE_LIMIT_DOWNLOAD_RESOURCE_MAX=24
AI_IMAGE_USER_RUNNING_TASK_LIMIT=2
AI_IMAGE_USER_QUEUED_TASK_LIMIT=5
AI_IMAGE_USER_ACTIVE_TASK_LIMIT=6

# Required in production when the image model returns b64_json originals.
AI_IMAGE_R2_ENDPOINT=
AI_IMAGE_R2_ACCESS_KEY_ID=
AI_IMAGE_R2_SECRET_ACCESS_KEY=
AI_IMAGE_R2_BUCKET_NAME=zaoyoeimages
AI_IMAGE_R2_PUBLIC_URL=https://cdn.fatherkey.com

# Defaults to auto: enabled for Sub2API/localhost Gemini native endpoints and
# disabled for direct official Gemini endpoints. Set false to force legacy path.
AI_IMAGE_GEMINI_URL_BRIDGE=

# Optional. Leave empty for auto defaults. Sub2API video models default to the
# documented task protocol: POST /v1/videos, poll /v1/videos/{task_id}, then
# download /v1/videos/{task_id}/content.
AI_IMAGE_VIDEO_ENDPOINT=

# Development only. Do not enable in production.
AI_IMAGE_ALLOW_INLINE_DATA_URLS=false
