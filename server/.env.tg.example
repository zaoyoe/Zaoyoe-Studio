# TG configuration supplement; contains no real credentials.
# Merge the TG keys into the EXISTING /opt/zaoyoe-verify-server/.env.
# Never replace that file: it also configures the current store and services.
# Keep the real file mode 0600 and leave all switches OFF until authorized launch.
APP_ENV=production
TG_REDEMPTION_ENABLED=false
TG_FULFILLMENT_ENABLED=false
TG_PURCHASE_ENABLED=false

# Direct purchases use independent TG orders and callback URLs.
# The existing CN shop ZPay merchant may be copied into these private variables.
# Current verified channel: alipay. Verify wxpay separately before adding it.
# Add usdt_bep20 only after its three dedicated settings below and the ninth
# TG migration are configured; do not reuse ZPay or Gramix credentials.
# Reconcile pending/ambiguous orders before rotating the merchant or key.
# Customer-facing prices are configured in the TG admin, in CNY.
# Gramix fulfillment is funded separately from the USDT balance below.
TG_PUBLIC_ORIGIN=https://tg.fatherkey.com
TG_PURCHASE_CHANNELS=alipay
TG_PURCHASE_ZPAY_API_BASE_URL=https://zpayz.cn
TG_PURCHASE_ZPAY_PID=
TG_PURCHASE_ZPAY_KEY=

# Optional customer USDT payments via NOWPayments, independent of Gramix funding.
# Fixed API: https://api.nowpayments.io ; fixed network: BSC / BEP20 (usdtbsc).
# Use distinct 16–300 character API and IPN secrets without edge whitespace.
# An explicit CNY-to-USD decimal rate is required (>0, <10, max 8 decimals).
# No default rate: the TG CNY catalog remains the source of retail prices.
# Payment creation freezes the settlement amount; missing settings hide USDT.
TG_PURCHASE_NOWPAYMENTS_API_KEY=
TG_PURCHASE_NOWPAYMENTS_IPN_SECRET=
TG_PURCHASE_NOWPAYMENTS_CNY_TO_USD_RATE=

# Use the EXISTING SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY from verify-server.
# Retain its Supabase publishable/anon key and ADMIN_STUDIO_ACCESS_SECRET
# (or ADMIN_CONFIG_ENCRYPTION_KEY) for the independent admin login/session.
# Do not paste credentials into chat, shell arguments, front-end config or Git.
TG_REDEMPTION_CODE_PEPPER=
TG_REDEMPTION_CODE_ENCRYPTION_KEY=
GRAMIX_API_KEY=
GRAMIX_API_BASE_URL=https://api.gramix.io/api/v1
GRAMIX_API_TIMEOUT_MS=15000
GRAMIX_PAYMENT_CURRENCY=usdt
TG_FULFILLMENT_POLL_SECONDS=15
TG_FULFILLMENT_LEASE_SECONDS=120

# Pepper: independently generate at least 32 random bytes, saved privately.
# Encryption key: a DIFFERENT random 32-byte key, encoded as 64 hex characters.
# Do not reuse CRON_SECRET, service-role key, another application's secrets,
# or one TG key as the other. Store key material separately from DB backups.
# NOWPayments API/IPN secrets must also differ from each other, ZPay/Gramix,
# admin-session/encryption credentials, database credentials and TG secrets.
# Never rotate pepper without a migration plan for outstanding codes.
# Keep the existing production rate-limit and proxy configuration intact.
