{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "buildCommand": null,
    "outputDirectory": ".",
    "cleanUrls": true,
    "trailingSlash": false,
    "git": {
        "deploymentEnabled": {
            "bot": false,
            "codex/*": false
        }
    },
    "functions": {
        "api/admin.js": {
            "maxDuration": 60
        }
    },
    "redirects": [
        {
            "source": "/gongyi",
            "destination": "https://gongyi.zaoyoe.com",
            "permanent": false
        },
        {
            "source": "/gongyi.html",
            "destination": "https://gongyi.zaoyoe.com",
            "permanent": false
        },
        {
            "source": "/status",
            "destination": "https://status.zaoyoe.com",
            "permanent": false
        },
        {
            "source": "/status.html",
            "destination": "https://status.zaoyoe.com",
            "permanent": false
        },
        {
            "source": "/:path*",
            "has": [
                {
                    "type": "host",
                    "value": "zaoyoe.com"
                }
            ],
            "destination": "https://www.zaoyoe.com/:path*",
            "permanent": true
        }
    ],
    "rewrites": [
        {
            "source": "/api/admin/:path*",
            "destination": "/api/admin?route=:path*"
        },
        {
            "source": "/api/auth/:path*",
            "destination": "/api/public?scope=auth&route=:path*"
        },
        {
            "source": "/api/payments/:path*",
            "destination": "/api/public?scope=payments&route=:path*"
        },
        {
            "source": "/api/runtime/:path*",
            "destination": "/api/public?scope=runtime&route=:path*"
        },
        {
            "source": "/api/shop/:path*",
            "destination": "/api/public?scope=shop&route=:path*"
        },
        {
            "source": "/api/wallet/:path*",
            "destination": "/api/public?scope=wallet&route=:path*"
        },
        {
            "source": "/api/:path*",
            "destination": "/api/:path*"
        },
        {
            "source": "/(.*)",
            "destination": "/$1.html"
        }
    ],
    "headers": [
        {
            "source": "/api/:path*",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "no-store, max-age=0"
                }
            ]
        },
        {
            "source": "/admin-studio",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "no-store, max-age=0"
                }
            ]
        },
        {
            "source": "/admin-studio.html",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "no-store, max-age=0"
                }
            ]
        },
        {
            "source": "/admin-entry",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "no-store, max-age=0"
                }
            ]
        },
        {
            "source": "/admin-entry.html",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "no-store, max-age=0"
                }
            ]
        },
        {
            "source": "/auth-callback",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "no-store, max-age=0"
                }
            ]
        },
        {
            "source": "/auth-callback.html",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "no-store, max-age=0"
                }
            ]
        },
        {
            "source": "/smoke-notifications",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "no-store, max-age=0"
                }
            ]
        },
        {
            "source": "/smoke-notifications.html",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "no-store, max-age=0"
                }
            ]
        },
        {
            "source": "/sw.js",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "no-store, max-age=0"
                }
            ]
        },
        {
            "source": "/:path*.js",
            "has": [
                {
                    "type": "query",
                    "key": "v"
                }
            ],
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=31536000, immutable"
                }
            ]
        },
        {
            "source": "/:path*.css",
            "has": [
                {
                    "type": "query",
                    "key": "v"
                }
            ],
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=31536000, immutable"
                }
            ]
        },
        {
            "source": "/(.*)",
            "headers": [
                {
                    "key": "X-Content-Type-Options",
                    "value": "nosniff"
                },
                {
                    "key": "X-Frame-Options",
                    "value": "DENY"
                },
                {
                    "key": "Referrer-Policy",
                    "value": "strict-origin-when-cross-origin"
                },
                {
                    "key": "Permissions-Policy",
                    "value": "camera=(), microphone=(), geolocation=()"
                },
                {
                    "key": "Strict-Transport-Security",
                    "value": "max-age=31536000; includeSubDomains; preload"
                },
                {
                    "key": "Cross-Origin-Opener-Policy",
                    "value": "same-origin-allow-popups"
                },
                {
                    "key": "Cross-Origin-Resource-Policy",
                    "value": "cross-origin"
                },
                {
                    "key": "Content-Security-Policy",
                    "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; img-src 'self' data: blob: https:; font-src 'self' data: https://fonts.gstatic.com https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com https://cdn.jsdelivr.net; script-src 'self' https://unpkg.com https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://cdn.sheetjs.com https://accounts.google.com https://www.gstatic.com; script-src-elem 'self' https://unpkg.com https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://cdn.sheetjs.com https://accounts.google.com https://www.gstatic.com; script-src-attr 'none'; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://zaoyoe-verify-server-production.up.railway.app https://iqless.icu https://*.localto.net https://ipinfo.io https://ipwho.is https://ipapi.co https://api.ipify.org https://api.qrserver.com https://accounts.google.com; frame-src https://accounts.google.com;"
                }
            ]
        }
    ]
}
