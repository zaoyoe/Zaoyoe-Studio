[Unit]
Description=Zaoyoe prompt import queue worker
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/zaoyoe-verify-server/app
Environment=NODE_ENV=production
EnvironmentFile=/opt/zaoyoe-verify-server/.env
ExecStart=/usr/bin/env npm run prompt-import:worker -- --env-file /opt/zaoyoe-verify-server/.env
Restart=always
RestartSec=8
TimeoutStopSec=30
KillSignal=SIGTERM
Nice=5
MemoryMax=768M
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/zaoyoe-verify-server

[Install]
WantedBy=multi-user.target
