[Unit]
Description=Zaoyoe continuous database RLS and zero-trust exposure audit
Wants=network-online.target docker.service
After=network-online.target docker.service
ConditionPathExists=/opt/zaoyoe-verify-server/.env

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/zaoyoe-db-security-audit
TimeoutStartSec=120
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/run/lock
