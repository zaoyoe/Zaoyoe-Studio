{
  "name": "zaoyoe-studio",
  "version": "1.0.0",
  "description": "AI Prompt Gallery",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "afdian:readiness": "node scripts/afdian-readiness-gate.js",
    "audit:env-drift": "node scripts/check-env-drift.js",
    "audit:deploy-health": "node scripts/check-prod-env.js --runtime-only --check-app-runtime --base-url https://www.fatherkey.com --expect-current-git-version",
    "audit:image-delivery": "node scripts/audit-image-delivery.js",
    "audit:payment-closeout": "node scripts/payment-postdeploy-audit.js",
    "audit:payment-profile-mapping": "node scripts/audit-payment-profile-mapping.js",
    "ai-image:worker": "node scripts/ai-image-worker.js",
    "build:vercel": "node api/_lib/vercel-build.js",
    "cleanup:homepage-inline-images": "node scripts/cleanup-homepage-inline-images.js",
    "cleanup:payment-fixtures": "node scripts/payment-cleanup-fixtures.js",
    "check:prod-env": "node scripts/check-prod-env.js",
    "deploy:kvm4:sub2api": "bash scripts/deploy-kvm4-sub2api.sh",
    "deploy:kvm4:verify": "bash scripts/deploy-kvm4-verify-server.sh",
    "install:kvm4:ai-image-worker": "bash scripts/install-kvm4-ai-image-worker.sh",
    "install:kvm4:watchdog": "bash scripts/install-kvm4-health-watchdog.sh",
    "inspect:proxy-chain": "node scripts/inspect-proxy-chain.js",
    "lockdown:supabase-image-buckets": "node scripts/lockdown-supabase-image-buckets.js",
    "marketplace:xianyu:admin": "node adapters/xianyu/adapter.js --from-admin",
    "marketplace:xianyu:bridge": "node adapters/xianyu/bridge-worker.js",
    "marketplace:xianyu:install-bot-bridge": "node integrations/xianyu-auto-reply-fix/install-bridge.js",
    "marketplace:xianyu:mock": "node adapters/xianyu/adapter.js",
    "marketplace:xianyu:smoke-bot-bridge": "node scripts/xianyu-bot-bridge-smoke.js",
    "migrate:chat-images": "node scripts/migrate-chat-images-to-r2.js",
    "migrate:prompt-images": "node scripts/migrate-prompt-images-to-r2.js",
    "normalize:r2-urls": "node scripts/normalize-r2-public-urls.js",
    "optimize-images": "node scripts/optimize-images.js",
    "preview:local": "node scripts/local-preview-server.js",
    "preflight:payment-rollout": "node scripts/payment-rollout-preflight.js",
    "readiness:auth-branding": "node scripts/auth-branding-readiness.js --fail-on-missing",
    "readiness:external-monitoring": "node scripts/external-monitoring-readiness.js",
    "readiness:financial-recovery-drill": "node scripts/financial-recovery-drill-readiness.js",
    "readiness:payment": "node scripts/payment-readiness-gate.js",
    "readiness:payment-recovery": "node scripts/payment-readiness-gate.js --fail-on-missing",
    "rollback:kvm4:sub2api": "bash scripts/rollback-kvm4-sub2api.sh",
    "rollback:kvm4:verify": "bash scripts/rollback-kvm4-verify-server.sh",
    "rollout:payment": "node scripts/payment-rollout-apply.js",
    "scan:payment-sites": "node scripts/scan-payment-site-values.js",
    "smoke:admin-analytics": "node scripts/admin-local-smoke.js --module analytics --timeout-ms 180000 --virtual-time-budget-ms 260000",
    "smoke:admin-all": "node scripts/admin-local-smoke.js --suite all",
    "smoke:admin-local": "node scripts/admin-local-smoke.js --suite core",
    "smoke:admin-payments": "node scripts/admin-local-smoke.js --module payments --timeout-ms 150000 --virtual-time-budget-ms 220000",
    "smoke:admin-shop": "node scripts/admin-local-smoke.js --module shop --timeout-ms 90000 --virtual-time-budget-ms 120000",
    "smoke:engagement-external": "node scripts/engagement-external-embed-smoke.js",
    "smoke:engagement-public": "node scripts/engagement-public-visual-smoke.js",
    "smoke:payment": "node scripts/payment-smoke-test.js",
    "smoke:realtime-production": "node scripts/realtime-production-smoke.js",
    "sub2api:docker:logs": "docker compose -f services/sub2api/deploy/docker-compose.local.yml logs -f sub2api",
    "sub2api:docker:restart": "docker compose -f services/sub2api/deploy/docker-compose.local.yml up -d --force-recreate sub2api",
    "sub2api:docker:up": "docker compose -f services/sub2api/deploy/docker-compose.local.yml up -d",
    "sub2api:frontend:build": "npm --prefix services/sub2api/frontend run build",
    "sub2api:frontend:install": "npm --prefix services/sub2api/frontend install",
    "sub2api:health": "curl --silent http://127.0.0.1:18080/health",
    "sync:payment-channel": "node scripts/payment-channel-config-sync.js",
    "verify:payment-rollout": "node scripts/payment-rollout-verify.js",
    "upload-to-r2": "node scripts/upload-to-r2.js",
    "test:security": "node --test --test-force-exit tests/*.test.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.985.0",
    "@supabase/supabase-js": "^2.95.3",
    "@vercel/functions": "^3.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "@google/generative-ai": "^0.24.1",
    "quantize": "^1.0.2"
  },
  "overrides": {
    "fast-xml-parser": "^5.7.0",
    "path-to-regexp": "^0.1.13",
    "qs": "^6.14.2"
  }
}
