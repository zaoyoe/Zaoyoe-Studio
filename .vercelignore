# Keep the deployed static surface explicit and boring.
node_modules/
.DS_Store
*.log
.vercel
.vercel-static/
.git
.github/

# Secrets and local environment material.
**/.env
**/.env.*
!**/.env.example
!**/.env.*.example
*.pem
*.key
*.p12

# Backend/source-only directories that must never be static assets.
/server/
/services/
/supabase/
/tests/
/tools/
/scripts/
/docs/
/cloud-functions/
/functions/

# Database, docs, backups, and generated internals.
**/*.sql
**/*.bak
**/*.backup
**/*.md
**/*.test.js
**/*.spec.js
**/*.tmp
**/*.py
**/*.sh
**/*.toml
**/coverage/
**/.nyc_output/
**/.temp/

# Local previews, smoke pages, and debug harnesses.
*preview*.html
*preview*.css
*preview*.js
**/*preview*.html
**/*preview*.css
**/*preview*.js
preview-*.html
**/preview-*.html
test-*.html
test*.js
test*.css
**/test*.html
**/test*.js
**/test*.css
test-realtime*.html
debug-*.html
debug*.js
debug*.css
**/debug*.html
**/debug*.js
**/debug*.css
smoke-*.html
smoke*.js
smoke*.css
**/smoke*.html
**/smoke*.js
**/smoke*.css
**/*smoke*.js
**/*smoke*.css
**/*old*.html
**/*old*.js
**/*old*.css
**/*migrate*.html
**/*migrate*.js
**/*migrate*.css
profile_*_preview.html
profile_security_*.html
logo_preview*.html
icons_preview*.html
admin_studio_*_preview.html
home_light_stream_color_preview.html
avatar_dropdown_preview.html
